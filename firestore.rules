rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isServant() {
      return isAuthenticated() && (
        request.auth.token.role == 'servant' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'servant'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAssignedServant(youthId) {
      return isServant() && (
        get(/databases/$(database)/documents/users/$(youthId)).data.assignedServantId == request.auth.uid
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isServant() || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.role == 'youth');
      allow update: if isAdmin() || isOwner(userId) || isAssignedServant(userId);
      allow delete: if isAdmin();
    }

    // 2. Daily Habit Logs
    match /dailyLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAssignedServant(resource.data.userId) ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 3. Sermons
    match /sermons/{sermonId} {
      allow read: if isAuthenticated();
      allow write: if isServant() || isAdmin();
    }

    // 4. Servant Private Notes (STRICT: Never readable by Youth)
    match /servantNotes/{noteId} {
      allow read, write: if isServant() || isAdmin();
    }

    // 5. Approval Requests
    match /approvalRequests/{requestId} {
      allow read: if isServant() || isAdmin();
      allow create: if isServant() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 6. Registration Requests
    match /registrationRequests/{requestId} {
      allow create: if true; // Public self-registration
      allow read: if isServant() || isAdmin();
      allow update: if isServant() || isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Servant to Youth Messages
    match /servantMessages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.youthId == request.auth.uid ||
        resource.data.servantId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isServant() || isAdmin();
      allow update: if isAuthenticated() && (
        resource.data.youthId == request.auth.uid || // Youth can mark as read
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 8. System Error Logs
    match /systemErrors/{errorId} {
      allow create: if true; // Any client can report an error
      allow read, update, delete: if isAdmin();
    }

    // 9. Monthly Sacred Archives
    match /monthlyArchives/{archiveId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
